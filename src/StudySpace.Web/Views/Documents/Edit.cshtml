@model DocumentFormViewModel
@{
    ViewData["Title"] = "Редагування документа";
}
<div class="row justify-content-center"><div class="col-lg-8">
    <div class="mb-4"><span class="eyebrow">НАЛАШТУВАННЯ ДОКУМЕНТА</span><h1 class="h2 mt-2">Редагування: @Model.Title</h1></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" class="panel-card">
        <input asp-for="Id" type="hidden" />
        @await Html.PartialAsync("_Form", Model)
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

