@model DocumentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="WorkspaceId" class="form-label fw-semibold">Робочий простір</label>
    <select asp-for="WorkspaceId" asp-items="ViewBag.Workspaces" class="form-select"><option value="">Оберіть робочий простір</option></select>
    <span asp-validation-for="WorkspaceId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Title" class="form-label fw-semibold"></label>
    <input asp-for="Title" class="form-control" placeholder="Зрозуміла й корисна назва" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Summary" class="form-label fw-semibold"></label>
    <textarea asp-for="Summary" class="form-control" rows="4" placeholder="Короткий опис допомагає іншим знайти потрібний документ."></textarea>
    <span asp-validation-for="Summary" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CoverImageUrl" class="form-label fw-semibold"></label>
    <input asp-for="CoverImageUrl" class="form-control" placeholder="https://..." />
    <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
</div>
<div class="mb-4">
    <label asp-for="Status" class="form-label fw-semibold"></label>
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<DocumentStatus>()" class="form-select"></select>
</div>
<div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">Зберегти документ</button>
    <a class="btn btn-outline-secondary" asp-controller="Workspaces" asp-action="Details" asp-route-id="@Model.WorkspaceId">Скасувати</a>
</div>

