@model Workspace
@{
    ViewData["Title"] = "Редагування простору";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4"><span class="eyebrow">НАЛАШТУВАННЯ ПРОСТОРУ</span><h1 class="h2 mt-2">Редагування: @Model.Name</h1></div>
        <form asp-action="Edit" asp-route-id="@Model.Id" class="panel-card">
            <input asp-for="Id" type="hidden" />
            @await Html.PartialAsync("_Form", Model)
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

