@model Workspace
@{
    ViewData["Title"] = "Видалення простору";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel-card">
            <span class="eyebrow">ПІДТВЕРДЖЕННЯ ВИДАЛЕННЯ</span>
            <h1 class="h2 mt-2">Видалити «@Model.Name»?</h1>
            <p class="text-secondary">Також буде видалено документів: @Model.Documents.Count. Цю дію не можна скасувати.</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <button class="btn btn-danger" type="submit">Видалити простір</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Скасувати</a>
            </form>
        </div>
    </div>
</div>

